  "controllers": [
    {
      "id": "C-101",
      "name": "Primary DCS Controller",
      "description": "Surge & Separation Unit Master Process Controller",
      "watchdog_timeout_seconds": 1.0,
      "enabled": true,
      "tasks": [
        {
          "id": "FastLogic",
          "name": "Fast Control Scan",
          "task_type": "periodic",
          "period_seconds": 0.05,
          "priority": 5,
          "watchdog_seconds": 0.8,
          "enabled": true,
          "programs": [
            {
              "id": "FlowControlLogic",
              "name": "Level & Flow Control Program",
              "description": "IEC 61131-3 logic for automated surge control",
              "program_type": "IEC",
              "routines": [
                {
                  "id": "ST_CONTROL",
                  "name": "ST_CONTROL",
                  "language": "ST",
                  "source_text": "VAR\n    PV_LEVEL : REAL := 50.0;\n    SP_LEVEL : REAL := 50.0;\n    VALVE_DEMAND : REAL := 50.0;\nEND_VAR\n\nIF PV_LEVEL < SP_LEVEL THEN\n    VALVE_DEMAND := VALVE_DEMAND + 0.5;\nELSIF PV_LEVEL > SP_LEVEL THEN\n    VALVE_DEMAND := VALVE_DEMAND - 0.5;\nEND_IF;\n",
                  "enabled": true
                }
              ]
            }
          ]
        }
      ],
      "cpu_profile": {
        "execution_budget_us": 50000,
        "max_scan_frequency_hz": 50.0,
        "utilization_threshold_pct": 80.0,
        "architecture": "VendorNeutral-VirtualVCPU-64"
      },
      "memory_profile": {
        "program_memory_bytes": 16777216,
        "data_memory_bytes": 33554432,
        "retentive_memory_bytes": 4194304
      },
      "firmware_profile": {
        "version": "v8.1.0",
        "build": "2026.09",
        "iec_standard": "IEC 61131-3:2013 Ed.3"
      },
      "redundancy": {
        "role": "Primary",
        "partner_controller_id": "C-101-STANDBY",
        "sync_frequency_hz": 20.0,
        "switchover_timeout_seconds": 0.1
      },
      "control_modules": [
        {
          "id": "LIC-101",
          "name": "Surge Drum Level Control Module",
          "description": "DCS regulatory loop regulating Vessel V-101 liquid level",
          "mode": "AUTO",
          "execution_rate_seconds": 0.05,
          "pv_signal": "V-101.LEVEL",
          "sp": 50.0,
          "out_signal": "FV-101.DEMAND",
          "strategy_type": "PID",
          "kp": 2.0,
          "ti": 10.0,
          "td": 0.0,
          "output_min": 0.0,
          "output_max": 100.0,
          "permissives": ["P-101.RUNNING"],
          "interlocks": ["ESD.ACTIVE"],
          "safe_position": 0.0
        }
      ]
    }
