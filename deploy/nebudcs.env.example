# ==============================================================================
# NebuDCS Production Environment Configuration Template
# Place at /etc/nebudcs/nebudcs.env with permissions 0600 (owner: nebudcs:nebudcs)
# ==============================================================================

# Network Listener
PORT=8088
BIND_ADDR=0.0.0.0:8088

# Multi-Role RBAC Secret Tokens (generate strong 32+ character random tokens)
ADMIN_TOKEN=sec-admin-change-me-in-production-482a9f
INSTRUCTOR_TOKEN=sec-inst-change-me-in-production-b71c3e
OPERATOR_TOKEN=sec-oper-change-me-in-production-c92d4f
TRAINEE_TOKEN=sec-train-change-me-in-production-e10a8b

# Optional Legacy Shared Token (maps to Admin role if set)
# AUTH_TOKEN=

# Persistent Data Storage
DATA_DIR=/var/lib/nebudcs/data

# Static Frontend Assets
STATIC_DIR=/var/lib/nebudcs/dist

# Token-Bucket Rate Limiter Settings
RATE_LIMIT_BURST=200
RATE_LIMIT_RPS=100.0

# CORS Allowed Origins (comma-separated or * for development)
# CORS_ALLOWED_ORIGINS=https://training.company.internal,https://control-room.company.internal

# Logging & Telemetry Level
RUST_LOG=info,nebudcs_server=debug
